<Project Sdk="Microsoft.NET.Sdk">
  <!-- Laplace-Native's C API for .NET. The sources are generated by tools/csharp/generate.mjs from include/laplace/*.h
       (CMake target csharp_bindings writes them to LaplaceNativeGenerated); nothing here is written by hand. The package
       carries the native library for the runtime it was built on (LaplaceNativeRuntime, LaplaceNativeRid). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <RootNamespace>Laplace.Native</RootNamespace>
    <PackageId>Laplace.Native.Interop</PackageId>
    <Authors>Laplace</Authors>
    <Description>Laplace-Native's exported C API (laplace.h and its headers), generated from the headers.</Description>
    <Version>$(LaplaceNativeVersion)</Version>
    <IsPackable>true</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- C names kept as C spells them (lp_id, lp_buf): lowercase type names are deliberate. -->
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(LaplaceNativeGenerated)/LaplaceNative.g.cs" />
    <Compile Include="$(LaplaceNativeGenerated)/Abi.g.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(LaplaceNativeWinX64)' != '' And Exists('$(LaplaceNativeWinX64)')">
    <None Include="$(LaplaceNativeWinX64)" Pack="true" PackagePath="runtimes/win-x64/native/" />
  </ItemGroup>
  <ItemGroup Condition="'$(LaplaceNativeLinuxX64)' != '' And Exists('$(LaplaceNativeLinuxX64)')">
    <None Include="$(LaplaceNativeLinuxX64)" Pack="true" PackagePath="runtimes/linux-x64/native/" />
  </ItemGroup>
  <ItemGroup Condition="'$(LaplaceNativeRuntime)' != '' And '$(LaplaceNativeRid)' != '' And !('$(LaplaceNativeRid)' == 'win-x64' And '$(LaplaceNativeWinX64)' != '') And !('$(LaplaceNativeRid)' == 'linux-x64' And '$(LaplaceNativeLinuxX64)' != '')">
    <None Include="$(LaplaceNativeRuntime)" Pack="true" PackagePath="runtimes/$(LaplaceNativeRid)/native/" />
  </ItemGroup>
</Project>
