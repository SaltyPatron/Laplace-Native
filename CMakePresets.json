{
  "version": 3,
  "configurePresets": [
    {
      "name": "icx-release",
      "displayName": "icx, release (primary)",
      "generator": "Ninja",
      "binaryDir": "$penv{LAPLACE_BUILD}/Laplace-Native/icx-release",
      "cacheVariables": { "CMAKE_C_COMPILER": "icx", "CMAKE_CXX_COMPILER": "icpx", "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "icx-debug",
      "displayName": "icx, debug",
      "generator": "Ninja",
      "binaryDir": "$penv{LAPLACE_BUILD}/Laplace-Native/icx-debug",
      "cacheVariables": { "CMAKE_C_COMPILER": "icx", "CMAKE_CXX_COMPILER": "icpx", "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "gcc-release",
      "displayName": "gcc, release (cross-compiler determinism check)",
      "generator": "Ninja",
      "binaryDir": "$penv{LAPLACE_BUILD}/Laplace-Native/gcc-release",
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++", "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    }
  ],
  "buildPresets": [
    { "name": "icx-release", "configurePreset": "icx-release" },
    { "name": "icx-debug", "configurePreset": "icx-debug" },
    { "name": "gcc-release", "configurePreset": "gcc-release" }
  ],
  "testPresets": [
    { "name": "icx-release", "configurePreset": "icx-release", "output": { "outputOnFailure": true } },
    { "name": "gcc-release", "configurePreset": "gcc-release", "output": { "outputOnFailure": true } }
  ]
}
