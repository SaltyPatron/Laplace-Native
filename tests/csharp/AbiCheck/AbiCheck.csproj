<Project Sdk="Microsoft.NET.Sdk">
  <!-- The binding against the library it binds: every struct laid out as C lays it out, and calls that return what C
       computes. Run by ctest csharp_abi. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../bindings/csharp/Laplace.Native.Interop.csproj" />
  </ItemGroup>
</Project>
