# Installs this build into a scratch prefix and builds tests/package against it: the package stands on its own.
# -DBUILD=<Native build> -DSOURCE=<Native source> -DWORK=<scratch> -DGENERATOR=... -DC_COMPILER=... [-DTOOLCHAIN=...]
file(REMOVE_RECURSE "${WORK}")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD}" --prefix "${WORK}/prefix" OUTPUT_QUIET RESULT_VARIABLE rc)
if(rc)
  message(FATAL_ERROR "install failed: ${rc}")
endif()
set(args -S "${SOURCE}/tests/package" -B "${WORK}/build" -G "${GENERATOR}" "-DCMAKE_C_COMPILER=${C_COMPILER}"
         "-DCMAKE_PREFIX_PATH=${WORK}/prefix" -DCMAKE_BUILD_TYPE=RelWithDebInfo)
if(TOOLCHAIN)
  list(APPEND args "-DCMAKE_TOOLCHAIN_FILE=${TOOLCHAIN}")
endif()
foreach(step IN ITEMS configure build run)
  if(step STREQUAL "configure")
    execute_process(COMMAND "${CMAKE_COMMAND}" ${args} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
  elseif(step STREQUAL "build")
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${WORK}/build" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
  else()
    execute_process(COMMAND "${WORK}/build/consumer" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
  endif()
  if(rc)
    message(FATAL_ERROR "${step} failed (${rc}):\n${out}")
  endif()
endforeach()
