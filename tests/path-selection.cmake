# Exercise the shared path owner through separate real CMake configurations.
foreach(required SOURCE WORK)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing path-selection setting ${required}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}/project")
file(WRITE "${WORK}/project/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.24)
project(PathSelection NONE)
if(DEFINED PARENT_TIER0)
  set(LAPLACE_TIER0 "${PARENT_TIER0}")
endif()
include("${PATHS_FILE}")
file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/selected.txt" CONTENT
"source=@LAPLACE_SRC@\nblake3=@LAPLACE_BLAKE3_DIR@\noperations=@LAPLACE_OPERATIONS@\ndeps=@LAPLACE_DEPS@\nicu=@LAPLACE_ICU_DIR@\ntier0=@LAPLACE_TIER0@\n" @ONLY)
]=])
set(environment)
foreach(name SRC DEPS TIER0 GRAMMARS ICU_DIR PG_DIR BLAKE3_DIR COREMATH OPERATIONS TREESITTER UCD)
  list(APPEND environment "--unset=LAPLACE_${name}")
endforeach()
function(configure profile revision)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${environment}
    "LAPLACE_SRC=${WORK}/source ${revision}" "LAPLACE_DEPS=${WORK}/deps ${revision}"
    "LAPLACE_UCD=${WORK}/unavailable-ucd"
    "${CMAKE_COMMAND}" -S "${WORK}/project" -B "${WORK}/${profile}"
    "-DPATHS_FILE=${SOURCE}/cmake/LaplacePaths.cmake" ${ARGN}
    WORKING_DIRECTORY "${WORK}" COMMAND_ERROR_IS_FATAL ANY OUTPUT_QUIET)
endfunction()
function(expect profile name value)
  file(STRINGS "${WORK}/${profile}/selected.txt" values)
  if(NOT "${name}=${value}" IN_LIST values)
    message(FATAL_ERROR "${profile}: expected ${name}=${value}; got ${values}")
  endif()
endfunction()
configure(defaults one)
expect(defaults source "${WORK}/source one")
configure(defaults two)
expect(defaults source "${WORK}/source two")
expect(defaults blake3 "${WORK}/source two/blake3/c")
expect(defaults operations "${WORK}/source two/Laplace-Operations")
expect(defaults icu "${WORK}/deps two/icu78")
file(STRINGS "${WORK}/defaults/CMakeCache.txt" leaked REGEX "^LAPLACE_(SRC|DEPS|BLAKE3_DIR|OPERATIONS|ICU_DIR):")
if(leaked)
  message(FATAL_ERROR "Environment defaults became persistent overrides: ${leaked}")
endif()
configure(pinned one "-DLAPLACE_SRC:PATH=${WORK}/pinned source" "-DLAPLACE_TIER0:PATH=${WORK}/pinned tier0")
configure(pinned two)
expect(pinned source "${WORK}/pinned source")
expect(pinned tier0 "${WORK}/pinned tier0")
configure(pinned two -ULAPLACE_SRC)
expect(pinned source "${WORK}/source two")
expect(pinned tier0 "${WORK}/pinned tier0")
configure(parent one "-DPARENT_TIER0=${WORK}/parent tier0")
expect(parent tier0 "${WORK}/parent tier0")
configure(relative one "-DLAPLACE_SRC=relative source" "-DLAPLACE_TIER0=relative tier0.bin")
expect(relative source "${WORK}/relative source")
expect(relative blake3 "${WORK}/relative source/blake3/c")
expect(relative tier0 "${WORK}/relative tier0.bin")
configure(relative two)
expect(relative source "${WORK}/relative source")
expect(relative tier0 "${WORK}/relative tier0.bin")
configure(relative two -ULAPLACE_SRC)
expect(relative source "${WORK}/source two")
expect(relative tier0 "${WORK}/relative tier0.bin")
file(TIMESTAMP "${WORK}/defaults/selected.txt" before "%s" UTC)
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1 COMMAND_ERROR_IS_FATAL ANY)
configure(defaults two)
file(TIMESTAMP "${WORK}/defaults/selected.txt" after "%s" UTC)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Unchanged selection rewrote generated configuration")
endif()
message(STATUS "Path defaults follow environment changes; explicit and parent selections persist; unchanged output is reused")
